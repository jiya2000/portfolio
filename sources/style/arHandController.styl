// -------------------------------------------------------------
// 🖐️ AR HAND CONTROLLER & COCKPIT HUD STYLES
// -------------------------------------------------------------

.ar-hand-trigger-pill
    position fixed
    bottom 86px
    right 24px
    z-index 999
    display flex
    align-items center
    gap 10px
    padding 10px 18px 10px 14px
    background radial-gradient(circle at top left, rgba(6, 182, 212, 0.35), rgba(15, 23, 42, 0.85))
    backdrop-filter blur(16px)
    -webkit-backdrop-filter blur(16px)
    border 1px solid rgba(56, 189, 248, 0.5)
    border-radius 999px
    color #ffffff
    cursor pointer
    box-shadow 0 8px 28px rgba(6, 182, 212, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.3)
    transition all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275)
    user-select none

    &:hover
        transform translateY(-3px) scale(1.04)
        border-color rgba(255, 255, 255, 0.8)
        box-shadow 0 12px 36px rgba(6, 182, 212, 0.6), 0 0 20px rgba(56, 189, 248, 0.5)

    &:active
        transform translateY(1px) scale(0.98)

    &.is-active
        border-color #38bdf8
        background radial-gradient(circle at top left, rgba(16, 185, 129, 0.35), rgba(15, 23, 42, 0.9))
        box-shadow 0 0 30px rgba(56, 189, 248, 0.7), inset 0 0 15px rgba(56, 189, 248, 0.4)

        .pill-pulse-cyan
            border-color rgba(16, 185, 129, 0.8)

    .pill-pulse-cyan
        position absolute
        inset -3px
        border-radius 999px
        border 2px solid rgba(56, 189, 248, 0.6)
        animation arHandPillPulse 2.4s infinite cubic-bezier(0.4, 0, 0.2, 1)
        pointer-events none

    .pill-icon
        font-size 22px
        line-height 1
        filter drop-shadow(0 0 8px rgba(56, 189, 248, 0.8))

    .pill-text-wrap
        display flex
        flex-direction column
        align-items flex-start
        gap 1px

    .pill-tag
        font-size 9px
        font-weight 800
        letter-spacing 1px
        text-transform uppercase

        &.cyan
            color #38bdf8

    .pill-title
        font-size 13px
        font-weight 700
        color #ffffff
        letter-spacing 0.3px

@keyframes arHandPillPulse
    0%
        transform scale(0.98)
        opacity 0.8
    50%
        transform scale(1.08)
        opacity 0
    100%
        transform scale(0.98)
        opacity 0

// -------------------------------------------------------------
// AR HAND PICTURE-IN-PICTURE COCKPIT HUD
// -------------------------------------------------------------

.ar-hand-hud
    position fixed
    bottom 24px
    left 24px
    z-index 9999
    width 340px
    max-width calc(100vw - 48px)
    background rgba(11, 15, 25, 0.88)
    backdrop-filter blur(18px)
    -webkit-backdrop-filter blur(18px)
    border 1px solid rgba(56, 189, 248, 0.4)
    border-radius 16px
    box-shadow 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 24px rgba(56, 189, 248, 0.25)
    overflow hidden
    transition opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease

    &.is-hidden
        opacity 0
        visibility hidden
        pointer-events none
        transform translateY(24px) scale(0.94)

    .hud-top-bar
        display flex
        align-items center
        justify-content space-between
        padding 10px 14px
        background rgba(15, 23, 42, 0.75)
        border-bottom 1px solid rgba(56, 189, 248, 0.25)

        .hud-status
            display flex
            align-items center
            gap 8px
            font-size 11px
            font-weight 800
            letter-spacing 1px
            color #38bdf8
            text-transform uppercase

            .hud-live-beacon
                width 8px
                height 8px
                border-radius 50%
                background #10b981
                box-shadow 0 0 10px #10b981
                animation arBeaconPulse 1.8s infinite ease-in-out

        .hud-top-actions
            display flex
            align-items center
            gap 6px

        .hud-action-btn
            padding 3px 8px
            background rgba(56, 189, 248, 0.15)
            border 1px solid rgba(56, 189, 248, 0.4)
            border-radius 6px
            color #38bdf8
            font-size 10px
            font-weight 700
            cursor pointer
            transition all 0.2s ease
            display flex
            align-items center
            gap 3px

            &:hover
                background rgba(56, 189, 248, 0.35)
                border-color rgba(56, 189, 248, 0.8)
                color #ffffff
                transform translateY(-1px)

            &:active
                transform translateY(1px) scale(0.96)

        .hud-close-btn
            width 24px
            height 24px
            display flex
            align-items center
            justify-content center
            background rgba(255, 255, 255, 0.08)
            border 1px solid rgba(255, 255, 255, 0.15)
            border-radius 6px
            color rgba(255, 255, 255, 0.8)
            font-size 12px
            cursor pointer
            transition all 0.2s ease

            &:hover
                background rgba(239, 68, 68, 0.3)
                border-color rgba(239, 68, 68, 0.6)
                color #ffffff
                transform scale(1.1)


    .hud-viewport
        position relative
        width 100%
        aspect-ratio 4 / 3
        background #050811
        overflow hidden

        .hand-webcam
            width 100%
            height 100%
            object-fit cover
            transform scaleX(-1)
            display block

        .hand-canvas
            position absolute
            inset 0
            width 100%
            height 100%
            pointer-events none
            display block

        // Sci-Fi Corner Brackets
        .hud-bracket-tl,
        .hud-bracket-tr,
        .hud-bracket-bl,
        .hud-bracket-br
            position absolute
            width 14px
            height 14px
            pointer-events none
            border-color #38bdf8
            border-style solid

        .hud-bracket-tl
            top 8px
            left 8px
            border-width 2px 0 0 2px

        .hud-bracket-tr
            top 8px
            right 8px
            border-width 2px 2px 0 0

        .hud-bracket-bl
            bottom 8px
            left 8px
            border-width 0 0 2px 2px

        .hud-bracket-br
            bottom 8px
            right 8px
            border-width 0 2px 2px 0

        // Neutral circle indicator
        .hud-neutral-circle
            position absolute
            top 50%
            left 50%
            width 12px
            height 12px
            margin-top -6px
            margin-left -6px
            border-radius 50%
            border 1px solid rgba(56, 189, 248, 0.5)
            pointer-events none

        // Telemetry readout
        .hud-telemetry-bar
            position absolute
            bottom 8px
            left 8px
            right 8px
            display flex
            justify-content space-between
            gap 6px
            pointer-events none
            z-index 10

            .telem-pill
                padding 4px 8px
                border-radius 6px
                background rgba(11, 15, 25, 0.75)
                backdrop-filter blur(8px)
                border 1px solid rgba(56, 189, 248, 0.3)
                font-family monospace, 'Courier New', sans-serif
                font-size 10px
                font-weight 700
                color #38bdf8
                letter-spacing 0.5px
                text-shadow 0 0 6px rgba(56, 189, 248, 0.5)

    .hud-hints
        padding 8px 12px
        font-size 10px
        line-height 1.4
        color rgba(255, 255, 255, 0.8)
        text-align center
        background rgba(15, 23, 42, 0.75)
        border-top 1px solid rgba(255, 255, 255, 0.08)

        strong
            color #38bdf8

@keyframes arBeaconPulse
    0%, 100%
        opacity 1
        transform scale(1)
    50%
        opacity 0.4
        transform scale(1.25)

@media (max-width 768px)
    .ar-hand-trigger-pill
        bottom 80px
        right 16px
        padding 8px 14px 8px 10px

        .pill-icon
            font-size 18px

        .pill-title
            font-size 11px

    .ar-hand-hud
        bottom 16px
        left 16px
        width 280px
