.ar-modal
    position relative
    width @css{ min(960px, calc(100vw - 40px)) }
    max-height @css{ min(680px, calc(100vh - 40px)) }
    background radial-gradient(ellipse at top left, #2d1828 0%, #17121b 100%)
    border 1px solid rgba(255, 255, 255, 0.22)
    border-radius 24px
    box-shadow 0 20px 60px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.2)
    overflow hidden
    display flex
    flex-direction column
    user-select none
    -webkit-user-select none

    @media only screen and (max-width 768px)
        width calc(100vw - 20px)
        max-height calc(100vh - 20px)
        border-radius 18px

    .close
        position absolute
        top 16px
        right 16px
        z-index 20
        width 40px
        height 40px
        background rgba(255, 255, 255, 0.08)
        border 1px solid rgba(255, 255, 255, 0.2)
        border-radius 50%
        cursor pointer
        display flex
        align-items center
        justify-content center
        transition all 0.2s ease

        &:hover
            background rgba(255, 255, 255, 0.2)
            transform scale(1.08)

        img
            width 14px
            height 14px
            filter brightness(0) invert(1)

    .ar-layout
        display flex
        width 100%
        height 100%
        padding 28px
        gap 28px
        box-sizing border-box

        @media only screen and (max-width 820px)
            flex-direction column
            padding 20px
            gap 18px
            overflow-y auto

    .ar-preview-side
        flex 1.2
        min-height 440px
        position relative
        background radial-gradient(ellipse at center, rgba(65, 30, 58, 0.45) 0%, rgba(20, 14, 24, 0.8) 100%)
        border 1px solid rgba(255, 255, 255, 0.12)
        border-radius 18px
        overflow hidden
        display flex
        flex-direction column
        align-items center
        justify-content center

        @media only screen and (max-width 820px)
            min-height 340px
            flex none

        model-viewer
            width 100%
            height 100%
            outline none
            --poster-color transparent

        .ar-launch-btn
            position absolute
            bottom 20px
            left 50%
            transform translateX(-50%)
            display inline-flex
            align-items center
            gap 10px
            background radial-gradient(ellipse at top right, #C21515, #5e1337)
            color #ffffff
            border 1px solid rgba(255, 255, 255, 0.3)
            border-radius 30px
            padding 12px 26px
            font-family 'Pally-Bold', sans-serif
            font-size 13px
            letter-spacing 0.8px
            text-transform uppercase
            cursor pointer
            box-shadow 0 8px 24px rgba(194, 21, 21, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.35)
            transition all 0.25s cubic-bezier(0.16, 1, 0.3, 1)
            white-space nowrap
            z-index 10

            &:hover
                transform translateX(-50%) translateY(-2px) scale(1.03)
                box-shadow 0 12px 30px rgba(194, 21, 21, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.5)

            &:active
                transform translateX(-50%) translateY(1px) scale(0.98)

            svg
                width 18px
                height 18px

        .ar-orbit-hint
            position absolute
            top 16px
            left 16px
            background rgba(0, 0, 0, 0.45)
            backdrop-filter blur(8px)
            border 1px solid rgba(255, 255, 255, 0.1)
            border-radius 20px
            padding 4px 12px
            font-family 'Nunito', sans-serif
            font-size 11px
            color rgba(255, 255, 255, 0.75)
            pointer-events none

    .ar-info-side
        flex 1
        display flex
        flex-direction column
        justify-content space-between
        gap 16px

        .ar-badge
            display inline-flex
            align-items center
            gap 6px
            align-self flex-start
            background rgba(194, 21, 21, 0.25)
            border 1px solid rgba(194, 21, 21, 0.6)
            color #ff6b81
            font-family 'Pally-Bold', sans-serif
            font-size 11px
            letter-spacing 1px
            text-transform uppercase
            padding 3px 10px
            border-radius 12px

        .ar-title
            margin 6px 0 0 0
            font-family 'Pally-Bold', sans-serif
            font-size 26px
            line-height 1.15
            color #ffffff
            letter-spacing -0.3px

            @media only screen and (max-width 768px)
                font-size 20px

        .ar-desc
            margin 6px 0 0 0
            font-family 'Nunito', sans-serif
            font-size 13px
            line-height 1.45
            color rgba(255, 255, 255, 0.7)

        .ar-features
            display flex
            flex-direction column
            gap 10px
            margin-top 6px

            .feature-row
                display flex
                align-items flex-start
                gap 12px
                background rgba(255, 255, 255, 0.04)
                border 1px solid rgba(255, 255, 255, 0.08)
                border-radius 12px
                padding 10px 12px

                .f-icon
                    font-size 18px
                    line-height 1
                    margin-top 2px

                .f-text
                    display flex
                    flex-direction column
                    gap 2px

                    strong
                        font-family 'Pally-Bold', sans-serif
                        font-size 12px
                        color #ffffff
                        letter-spacing 0.3px

                    span
                        font-family 'Nunito', sans-serif
                        font-size 11.5px
                        color rgba(255, 255, 255, 0.65)
                        line-height 1.35

        .ar-mobile-qr-section
            background rgba(0, 0, 0, 0.3)
            border 1px solid rgba(255, 255, 255, 0.1)
            border-radius 16px
            padding 14px
            display flex
            align-items center
            gap 14px

            @media only screen and (max-width 480px)
                flex-direction column
                text-align center

            .qr-code-display
                flex-shrink 0
                width 88px
                height 88px
                background #ffffff
                border 2px solid rgba(255, 255, 255, 0.4)
                border-radius 12px
                padding 6px
                display flex
                align-items center
                justify-content center
                box-sizing border-box
                overflow hidden
                box-shadow 0 4px 16px rgba(0, 0, 0, 0.4)

                img
                    width 100%
                    height 100%
                    max-width 100%
                    max-height 100%
                    object-fit contain
                    display block

            .qr-instructions
                display flex
                flex-direction column
                gap 4px

                .qr-title
                    font-family 'Pally-Bold', sans-serif
                    font-size 13px
                    color #ffffff
                    letter-spacing 0.2px

                .qr-detail
                    font-family 'Nunito', sans-serif
                    font-size 11.5px
                    color rgba(255, 255, 255, 0.65)
                    line-height 1.35

                    .ar-url-code
                        display inline-block
                        background rgba(255, 255, 255, 0.1)
                        color #ffd166
                        padding 1px 6px
                        border-radius 6px
                        font-family monospace
                        font-size 11px
                        word-break break-all

                .copy-btn
                    align-self flex-start
                    margin-top 4px
                    background rgba(255, 255, 255, 0.08)
                    border 1px solid rgba(255, 255, 255, 0.15)
                    color #ffffff
                    font-family 'Pally-Bold', sans-serif
                    font-size 11px
                    padding 5px 12px
                    border-radius 14px
                    cursor pointer
                    transition all 0.2s ease

                    &:hover
                        background rgba(255, 255, 255, 0.18)

                .status-msg
                    font-size 11px
                    color #4ade80
                    min-height 14px
