*
    box-sizing border-box
    margin 0
    padding 0
    -webkit-tap-highlight-color transparent
    user-select none
    -webkit-user-select none

html, body
    width 100%
    height 100%
    overflow hidden
    background #0a060d
    font-family 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif
    color #ffffff

#ar-app
    position relative
    width 100%
    height 100%
    overflow hidden

/* Camera Background Video */
.camera-feed
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    object-fit cover
    z-index 1
    transform scaleX(1)
    transition filter 0.3s ease

.camera-feed.is-front
    transform scaleX(-1)

.camera-fallback
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    z-index 0
    background radial-gradient(circle at 50% 40%, #30172c 0%, #110915 80%, #08040a 100%)
    display flex
    flex-direction column
    align-items center
    justify-content center

/* Three.js Overlay Canvas */
.ar-canvas
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    z-index 2
    touch-action none
    outline none

/* HUD Overlay Layer */
.ar-hud
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    z-index 3
    pointer-events none
    display flex
    flex-direction column
    justify-content space-between
    padding @css{ env(safe-area-inset-top, 16px) env(safe-area-inset-right, 16px) env(safe-area-inset-bottom, 16px) env(safe-area-inset-left, 16px) }

/* Top Header Bar */
.hud-top
    display flex
    align-items flex-start
    justify-content space-between
    gap 12px
    pointer-events auto

.character-card
    display flex
    align-items center
    gap 12px
    background rgba(23, 14, 25, 0.78)
    backdrop-filter blur(14px)
    -webkit-backdrop-filter blur(14px)
    border 1px solid rgba(255, 255, 255, 0.18)
    border-radius 24px
    padding 8px 16px 8px 10px
    box-shadow 0 8px 32px rgba(0, 0, 0, 0.45)

    .avatar-icon
        width 42px
        height 42px
        border-radius 50%
        background radial-gradient(circle, #e11d48, #881337)
        border 2px solid rgba(255, 255, 255, 0.6)
        display flex
        align-items center
        justify-content center
        font-size 20px
        box-shadow 0 0 16px rgba(225, 29, 72, 0.6)

    .character-info
        display flex
        flex-direction column
        gap 2px

        .name-row
            display flex
            align-items center
            gap 8px

            .char-name
                font-family 'Pally-Bold', sans-serif
                font-weight 700
                font-size 15px
                color #ffffff
                letter-spacing 0.2px

            .cp-badge
                background rgba(225, 29, 72, 0.3)
                border 1px solid rgba(225, 29, 72, 0.8)
                color #fecdd3
                font-size 10px
                font-weight 800
                padding 1px 6px
                border-radius 10px
                letter-spacing 0.5px

        .char-subtitle
            font-size 11.5px
            color rgba(255, 255, 255, 0.72)

.top-buttons
    display flex
    align-items center
    gap 8px

.icon-btn
    width 42px
    height 42px
    border-radius 50%
    background rgba(23, 14, 25, 0.8)
    backdrop-filter blur(12px)
    -webkit-backdrop-filter blur(12px)
    border 1px solid rgba(255, 255, 255, 0.2)
    color #ffffff
    display flex
    align-items center
    justify-content center
    cursor pointer
    box-shadow 0 6px 20px rgba(0, 0, 0, 0.35)
    transition all 0.2s ease

    &:active
        transform scale(0.92)
        background rgba(225, 29, 72, 0.4)

    svg
        width 20px
        height 20px

/* AR Status Pill */
.hud-status-pill
    align-self center
    margin-top 8px
    background rgba(0, 0, 0, 0.55)
    backdrop-filter blur(10px)
    -webkit-backdrop-filter blur(10px)
    border 1px solid rgba(255, 255, 255, 0.15)
    border-radius 20px
    padding 5px 14px
    display flex
    align-items center
    gap 8px
    font-size 12px
    color rgba(255, 255, 255, 0.88)
    pointer-events auto

    .live-dot
        width 8px
        height 8px
        border-radius 50%
        background #22c55e
        box-shadow 0 0 10px #22c55e
        animation pulse 1.8s infinite

@keyframes pulse
    0%
        opacity 0.6
        transform scale(0.9)
    50%
        opacity 1
        transform scale(1.2)
    100%
        opacity 0.6
        transform scale(0.9)

/* Speech bubble over Aditi */
.speech-bubble
    position absolute
    z-index 5
    background rgba(255, 255, 255, 0.96)
    color #170d18
    font-family 'Pally-Bold', sans-serif
    font-size 13px
    padding 8px 16px
    border-radius 16px
    box-shadow 0 8px 24px rgba(0, 0, 0, 0.35)
    pointer-events none
    opacity 0
    transform translateY(10px) scale(0.9)
    transition all 0.3s cubic-bezier(0.16, 1, 0.3, 1)

    &.is-visible
        opacity 1
        transform translateY(0) scale(1)

    &:after
        content ''
        position absolute
        bottom -8px
        left 50%
        transform translateX(-50%)
        border-width 8px 8px 0 8px
        border-style solid
        border-color rgba(255, 255, 255, 0.96) transparent transparent transparent

/* Bottom Controls & Action Bar */
.hud-bottom
    display flex
    flex-direction column
    align-items center
    gap 12px
    pointer-events auto
    width 100%
    max-width 480px
    margin 0 auto

/* Floating Project Chips Bar */
.project-chips
    display flex
    align-items center
    gap 8px
    overflow-x auto
    max-width 100%
    padding 4px 6px
    scrollbar-width none
    &::-webkit-scrollbar
        display none

.chip-btn
    flex-shrink 0
    background rgba(23, 14, 25, 0.8)
    backdrop-filter blur(10px)
    -webkit-backdrop-filter blur(10px)
    border 1px solid rgba(255, 255, 255, 0.16)
    color #ffffff
    font-size 11.5px
    font-weight 600
    padding 7px 14px
    border-radius 18px
    cursor pointer
    display flex
    align-items center
    gap 6px
    transition all 0.2s ease

    &:active, &.is-active
        background radial-gradient(circle, #e11d48, #9f1239)
        border-color rgba(255, 255, 255, 0.5)
        transform scale(1.04)

/* Main Pokemon GO Action Wheel */
.action-wheel
    display flex
    align-items center
    justify-content center
    gap 16px
    width 100%

.hud-action-btn
    border-radius 50%
    display flex
    flex-direction column
    align-items center
    justify-content center
    cursor pointer
    border 2px solid rgba(255, 255, 255, 0.28)
    color #ffffff
    transition all 0.2s cubic-bezier(0.16, 1, 0.3, 1)
    box-shadow 0 8px 24px rgba(0, 0, 0, 0.45)

    &:active
        transform scale(0.9)

.btn-secondary
    width 52px
    height 52px
    background rgba(32, 18, 36, 0.85)
    backdrop-filter blur(12px)
    -webkit-backdrop-filter blur(12px)

    svg
        width 22px
        height 22px

    .btn-label
        display none

/* Center Shutter Button (Pokemon GO Pokéball / Camera Shutter style) */
.btn-shutter
    width 72px
    height 72px
    background radial-gradient(circle at 35% 35%, #ffffff 0%, #f1f5f9 60%, #cbd5e1 100%)
    border 4px solid #e11d48
    box-shadow 0 0 24px rgba(225, 29, 72, 0.55), 0 10px 30px rgba(0, 0, 0, 0.6)
    position relative

    &:before
        content ''
        position absolute
        width 24px
        height 24px
        border-radius 50%
        background #e11d48
        box-shadow 0 0 12px rgba(225, 29, 72, 0.8)

    &:active
        transform scale(0.92)
        box-shadow 0 0 35px rgba(225, 29, 72, 0.9)

/* Native Apple Quick Look AR Button */
.apple-ar-badge
    width 100%
    display flex
    align-items center
    justify-content center
    gap 8px
    background radial-gradient(ellipse at center, rgba(225, 29, 72, 0.35) 0%, rgba(136, 19, 55, 0.5) 100%)
    border 1px solid rgba(225, 29, 72, 0.6)
    color #ffffff
    font-family 'Pally-Bold', sans-serif
    font-size 12.5px
    letter-spacing 0.3px
    padding 9px 18px
    border-radius 24px
    text-decoration none
    box-shadow 0 4px 18px rgba(225, 29, 72, 0.3)
    transition all 0.2s ease

    &:hover, &:active
        background radial-gradient(ellipse at center, rgba(225, 29, 72, 0.6) 0%, rgba(136, 19, 55, 0.8) 100%)
        border-color rgba(255, 255, 255, 0.7)
        transform scale(1.02)

    svg
        width 16px
        height 16px

/* Gestures Hint */
.gesture-hint
    font-size 11px
    color rgba(255, 255, 255, 0.6)
    letter-spacing 0.2px
    text-align center

/* Project Hologram Modal */
.holo-modal
    position absolute
    top 50%
    left 50%
    transform translate(-50%, -50%) scale(0.9)
    width @css{ min(380px, calc(100vw - 32px)) }
    background radial-gradient(ellipse at top left, #291629 0%, #150d18 100%)
    border 1px solid rgba(225, 29, 72, 0.5)
    border-radius 22px
    padding 22px
    box-shadow 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(225, 29, 72, 0.3)
    z-index 10
    opacity 0
    pointer-events none
    transition all 0.25s cubic-bezier(0.16, 1, 0.3, 1)

    &.is-open
        opacity 1
        pointer-events auto
        transform translate(-50%, -50%) scale(1)

    .modal-close
        position absolute
        top 12px
        right 12px
        width 32px
        height 32px
        border-radius 50%
        background rgba(255, 255, 255, 0.08)
        border 1px solid rgba(255, 255, 255, 0.2)
        color #ffffff
        display flex
        align-items center
        justify-content center
        cursor pointer

    .modal-tag
        display inline-block
        background rgba(225, 29, 72, 0.25)
        border 1px solid rgba(225, 29, 72, 0.6)
        color #ff6b81
        font-size 10.5px
        font-weight 800
        padding 2px 8px
        border-radius 10px
        text-transform uppercase
        margin-bottom 8px

    .modal-title
        font-family 'Pally-Bold', sans-serif
        font-size 20px
        color #ffffff
        margin-bottom 6px

    .modal-desc
        font-size 12.5px
        line-height 1.45
        color rgba(255, 255, 255, 0.75)
        margin-bottom 14px

    .modal-tags
        display flex
        flex-wrap wrap
        gap 6px
        margin-bottom 16px

        span
            background rgba(255, 255, 255, 0.08)
            border 1px solid rgba(255, 255, 255, 0.12)
            color rgba(255, 255, 255, 0.9)
            font-size 11px
            padding 3px 8px
            border-radius 8px

    .modal-link
        display block
        text-align center
        background radial-gradient(circle, #e11d48, #9f1239)
        color #ffffff
        font-family 'Pally-Bold', sans-serif
        font-size 13px
        padding 10px
        border-radius 16px
        text-decoration none
        box-shadow 0 6px 20px rgba(225, 29, 72, 0.4)

/* Camera Permission Banner */
.permission-banner
    position absolute
    top 50%
    left 50%
    transform translate(-50%, -50%)
    width @css{ min(360px, calc(100vw - 32px)) }
    background rgba(23, 14, 25, 0.94)
    backdrop-filter blur(16px)
    -webkit-backdrop-filter blur(16px)
    border 1px solid rgba(255, 255, 255, 0.22)
    border-radius 24px
    padding 26px 22px
    text-align center
    z-index 20
    box-shadow 0 20px 60px rgba(0, 0, 0, 0.7)
    display flex
    flex-direction column
    align-items center
    gap 12px

    &.is-hidden
        display none

    .banner-icon
        font-size 44px
        margin-bottom 4px

    h2
        font-family 'Pally-Bold', sans-serif
        font-size 20px
        color #ffffff

    p
        font-size 12.5px
        line-height 1.45
        color rgba(255, 255, 255, 0.75)

    .enable-btn
        width 100%
        background radial-gradient(circle, #e11d48, #9f1239)
        border 1px solid rgba(255, 255, 255, 0.3)
        color #ffffff
        font-family 'Pally-Bold', sans-serif
        font-size 14px
        padding 12px
        border-radius 20px
        cursor pointer
        box-shadow 0 6px 24px rgba(225, 29, 72, 0.5)

/* Shutter Flash Animation */
.shutter-flash
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    background #ffffff
    z-index 30
    opacity 0
    pointer-events none
    transition opacity 0.08s ease

    &.is-flashing
        opacity 0.95
