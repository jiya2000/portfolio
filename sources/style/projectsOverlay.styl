.project-details-overlay
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    pointer-events none
    z-index 1000
    display flex
    justify-content flex-end
    align-items center
    padding 24px 32px
    box-sizing border-box
    opacity 0
    visibility hidden
    transition opacity 0.35s ease, visibility 0.35s ease

    &.is-active
        opacity 1
        visibility visible
        pointer-events auto

    .project-details-backdrop
        position absolute
        top 0
        left 0
        width 100%
        height 100%
        background rgba(6, 9, 18, 0.45)
        backdrop-filter blur(4px)
        -webkit-backdrop-filter blur(4px)
        z-index 1
        cursor pointer

    .project-details-card
        position relative
        z-index 2
        width 100%
        max-width 500px
        max-height calc(100vh - 48px)
        background rgba(13, 17, 28, 0.94)
        backdrop-filter blur(24px)
        -webkit-backdrop-filter blur(24px)
        border 1px solid rgba(255, 255, 255, 0.14)
        border-radius 24px
        box-shadow 0 24px 60px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.15)
        display flex
        flex-direction column
        overflow hidden
        box-sizing border-box
        transform translateX(40px) scale(0.96)
        transition transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)

    &.is-active .project-details-card
        transform translateX(0) scale(1)

    .project-header
        display flex
        justify-content space-between
        align-items center
        padding 18px 24px
        border-bottom 1px solid rgba(255, 255, 255, 0.08)
        background rgba(255, 255, 255, 0.02)

    .project-meta
        display flex
        align-items center
        gap 10px
        flex-wrap wrap

    .project-badge
        display inline-flex
        align-items center
        gap 6px
        padding 4px 12px
        border-radius 999px
        background rgba(59, 130, 246, 0.16)
        border 1px solid rgba(59, 130, 246, 0.35)
        color #60a5fa
        font-family 'Inter', -apple-system, sans-serif
        font-size 11px
        font-weight 600
        letter-spacing 0.3px
        text-transform uppercase

    .project-counter
        color #94a3b8
        font-family 'Inter', -apple-system, sans-serif
        font-size 12px
        font-weight 600
        letter-spacing 0.5px
        background rgba(255, 255, 255, 0.06)
        padding 3px 10px
        border-radius 12px

    .project-close-btn
        display inline-flex
        align-items center
        gap 6px
        padding 6px 12px
        background rgba(255, 255, 255, 0.08)
        border 1px solid rgba(255, 255, 255, 0.16)
        border-radius 12px
        color #f8fafc
        cursor pointer
        font-family 'Inter', -apple-system, sans-serif
        font-size 12px
        font-weight 600
        transition all 0.2s ease

        &:hover
            background rgba(239, 68, 68, 0.2)
            border-color rgba(239, 68, 68, 0.5)
            color #fca5a5
            transform scale(1.03)

        .close-key
            background rgba(255, 255, 255, 0.15)
            padding 2px 6px
            border-radius 6px
            font-size 10px
            letter-spacing 0.5px

    .project-content-scroll
        padding 20px 24px
        overflow-y auto
        flex 1
        display flex
        flex-direction column
        gap 18px

        &::-webkit-scrollbar
            width 5px

        &::-webkit-scrollbar-track
            background rgba(0, 0, 0, 0.1)

        &::-webkit-scrollbar-thumb
            background rgba(255, 255, 255, 0.2)
            border-radius 4px

    .project-title
        margin 0
        color #ffffff
        font-family 'Outfit', 'Inter', -apple-system, sans-serif
        font-size 22px
        font-weight 700
        line-height 1.3
        letter-spacing -0.3px

    .project-tagline
        margin 0
        color #38bdf8
        font-family 'Inter', -apple-system, sans-serif
        font-size 13px
        font-weight 500
        line-height 1.4

    .project-block
        display flex
        flex-direction column
        gap 6px

    .block-title
        display flex
        align-items center
        gap 6px
        color #94a3b8
        font-family 'Inter', -apple-system, sans-serif
        font-size 11px
        font-weight 700
        text-transform uppercase
        letter-spacing 0.6px

    .block-text
        margin 0
        color #e2e8f0
        font-family 'Inter', -apple-system, sans-serif
        font-size 13px
        line-height 1.55

    .project-features-list
        margin 0
        padding-left 18px
        display flex
        flex-direction column
        gap 6px

        li
            color #cbd5e1
            font-family 'Inter', -apple-system, sans-serif
            font-size 12.5px
            line-height 1.45

            &::marker
                color #38bdf8

    .project-tech-tags
        display flex
        flex-wrap wrap
        gap 6px

    .tech-tag
        display inline-block
        padding 4px 10px
        background rgba(255, 255, 255, 0.05)
        border 1px solid rgba(255, 255, 255, 0.1)
        border-radius 999px
        color #cbd5e1
        font-family 'Inter', -apple-system, sans-serif
        font-size 11px
        font-weight 500
        transition background 0.2s ease

        &:hover
            background rgba(255, 255, 255, 0.12)
            color #ffffff

    .project-footer
        padding 16px 24px
        border-top 1px solid rgba(255, 255, 255, 0.08)
        background rgba(255, 255, 255, 0.02)
        display flex
        flex-direction column
        gap 12px

    .project-nav-buttons
        display flex
        gap 10px

    .project-nav-btn
        flex 1
        display flex
        align-items center
        justify-content center
        gap 8px
        padding 9px 14px
        background rgba(255, 255, 255, 0.06)
        border 1px solid rgba(255, 255, 255, 0.12)
        border-radius 12px
        color #f1f5f9
        cursor pointer
        font-family 'Inter', -apple-system, sans-serif
        font-size 12.5px
        font-weight 600
        transition all 0.2s ease

        &:hover
            background rgba(255, 255, 255, 0.14)
            border-color rgba(255, 255, 255, 0.24)
            transform translateY(-1px)

        .kbd-hint
            color #94a3b8
            font-size 10px
            background rgba(0, 0, 0, 0.25)
            padding 2px 6px
            border-radius 4px

    .project-github-link
        display flex
        align-items center
        justify-content center
        gap 10px
        width 100%
        padding 12px 18px
        box-sizing border-box
        background linear-gradient(135deg, #2563eb 0%, #7c3aed 100%)
        border 1px solid rgba(255, 255, 255, 0.2)
        border-radius 14px
        color #ffffff
        text-decoration none
        font-family 'Inter', -apple-system, sans-serif
        font-size 13.5px
        font-weight 600
        letter-spacing 0.2px
        box-shadow 0 4px 18px rgba(37, 99, 235, 0.35)
        transition all 0.25s ease

        &:hover
            background linear-gradient(135deg, #1d4ed8 0%, #6d28d9 100%)
            box-shadow 0 6px 24px rgba(37, 99, 235, 0.55)
            transform translateY(-2px)
            color #ffffff

@media (max-width: 768px)
    .project-details-overlay
        padding 12px
        align-items flex-end

        .project-details-card
            max-width 100%
            max-height 85vh
            border-radius 20px 20px 16px 16px
            transform translateY(40px) scale(0.96)

        &.is-active .project-details-card
            transform translateY(0) scale(1)

        .project-title
            font-size 18px

        .project-content-scroll
            padding 16px
            gap 14px
