@font-face
    font-family 'Pally-Bold'
    src url('/fonts/Pally-Bold.woff2') format('woff2')
    font-weight 700
    font-style normal

*
    box-sizing border-box
    margin 0
    padding 0
    user-select none
    -webkit-user-select none
    -webkit-touch-callout none

html, body
    width 100%
    height 100%
    overflow hidden
    background #0a060d
    font-family 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif
    color #ffffff

/* Main WebGL VR Canvas */
.vr-canvas
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    display block
    z-index 1

/* Center Split Line for Stereoscopic Cardboard Mode */
.stereo-divider
    position absolute
    top 0
    left 50%
    width 2px
    height 100%
    transform translateX(-50%)
    background rgba(255, 255, 255, 0.15)
    z-index 4
    pointer-events none
    display none

    &.is-active
        display block

/* Gaze Reticle / Crosshair (Center of vision in VR) */
.gaze-reticle
    position absolute
    top 50%
    left 50%
    transform translate(-50%, -50%)
    width 24px
    height 24px
    z-index 8
    pointer-events none
    display flex
    align-items center
    justify-content center

    .reticle-dot
        width 6px
        height 6px
        border-radius 50%
        background #a855f7
        box-shadow 0 0 10px #a855f7, 0 0 20px #c084fc
        transition transform 0.15s ease

    .reticle-ring
        position absolute
        width 24px
        height 24px
        border-radius 50%
        border 2px solid rgba(255, 255, 255, 0.3)
        transform scale(0.8)
        opacity 0.6
        transition all 0.2s ease

    &.is-gazing
        .reticle-dot
            transform scale(1.6)
            background #ec4899
            box-shadow 0 0 14px #ec4899

        .reticle-ring
            border-color #ec4899
            transform scale(1.3)
            opacity 1
            box-shadow 0 0 12px rgba(236, 72, 153, 0.8)

/* Dual Reticle for Stereoscopic mode (Left and Right eyes) */
.gaze-reticle-left,
.gaze-reticle-right
    position absolute
    top 50%
    transform translate(-50%, -50%)
    width 24px
    height 24px
    z-index 8
    pointer-events none
    display none
    align-items center
    justify-content center

    .reticle-dot
        width 6px
        height 6px
        border-radius 50%
        background #a855f7
        box-shadow 0 0 10px #a855f7

    .reticle-ring
        position absolute
        width 24px
        height 24px
        border-radius 50%
        border 2px solid rgba(255, 255, 255, 0.3)

    &.is-gazing
        .reticle-dot
            transform scale(1.6)
            background #ec4899
        .reticle-ring
            border-color #ec4899
            transform scale(1.3)

.gaze-reticle-left
    left 25%

.gaze-reticle-right
    left 75%

.stereo-reticles-active
    .gaze-reticle
        display none
    .gaze-reticle-left,
    .gaze-reticle-right
        display flex

/* Interactive VR HUD */
.vr-hud
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    z-index 5
    pointer-events none
    display flex
    flex-direction column
    justify-content space-between
    padding 16px
    transition opacity 0.3s ease

    &.is-hidden
        opacity 0
        pointer-events none

/* Top Bar */
.hud-top
    display flex
    align-items center
    justify-content space-between
    width 100%
    pointer-events auto

.brand-badge
    background rgba(22, 13, 26, 0.85)
    backdrop-filter blur(14px)
    -webkit-backdrop-filter blur(14px)
    border 1px solid rgba(192, 132, 252, 0.4)
    border-radius 24px
    padding 6px 14px
    display flex
    align-items center
    gap 8px
    box-shadow 0 8px 24px rgba(0, 0, 0, 0.45)

    .brand-icon
        font-size 18px

    .brand-title
        font-family 'Pally-Bold', sans-serif
        font-size 13px
        font-weight 800
        letter-spacing 0.5px
        color #ffffff

    .brand-sub
        font-size 10px
        color #c084fc
        font-weight 700
        text-transform uppercase
        letter-spacing 0.6px

.hud-actions
    display flex
    align-items center
    gap 8px

.hud-btn
    height 38px
    padding 0 12px
    border-radius 20px
    background rgba(22, 13, 26, 0.85)
    backdrop-filter blur(14px)
    -webkit-backdrop-filter blur(14px)
    border 1px solid rgba(255, 255, 255, 0.2)
    color #ffffff
    font-size 12px
    font-weight 700
    display inline-flex
    align-items center
    gap 6px
    cursor pointer
    transition all 0.2s ease
    box-shadow 0 6px 20px rgba(0, 0, 0, 0.4)

    &:active
        transform scale(0.92)

    &.is-highlight
        background radial-gradient(circle, #a855f7, #6b21a8)
        border-color rgba(255, 255, 255, 0.5)
        box-shadow 0 0 16px rgba(168, 85, 247, 0.5)

    svg
        width 16px
        height 16px

/* VR Mode Selector Dock */
.hud-mode-dock
    align-self center
    background rgba(20, 11, 25, 0.90)
    backdrop-filter blur(16px)
    -webkit-backdrop-filter blur(16px)
    border 1px solid rgba(255, 255, 255, 0.18)
    border-radius 24px
    padding 4px 6px
    display flex
    align-items center
    gap 4px
    pointer-events auto
    box-shadow 0 8px 30px rgba(0, 0, 0, 0.6)

.mode-tab
    background transparent
    border 1px solid transparent
    border-radius 18px
    padding 6px 12px
    color rgba(255, 255, 255, 0.75)
    font-size 11px
    font-weight 700
    display flex
    align-items center
    gap 5px
    cursor pointer
    transition all 0.2s ease

    &:active
        transform scale(0.95)

    &.is-active
        background radial-gradient(circle, #9333ea, #581c87)
        border-color rgba(216, 180, 254, 0.6)
        color #ffffff
        box-shadow 0 0 14px rgba(147, 51, 234, 0.6)

/* Gaze Dwell Progress Ring (Floating in 3D or on HUD) */
.gaze-progress-container
    position absolute
    top 50%
    left 50%
    transform translate(-50%, -50%)
    width 50px
    height 50px
    pointer-events none
    z-index 9
    opacity 0
    transition opacity 0.15s ease

    &.is-active
        opacity 1

    svg
        width 100%
        height 100%
        transform rotate(-90deg)

    circle
        fill none
        stroke-width 4
        stroke-linecap round

    .progress-bg
        stroke rgba(255, 255, 255, 0.2)

    .progress-bar
        stroke #ec4899
        stroke-dasharray 126
        stroke-dashoffset 126
        transition stroke-dashoffset 0.05s linear

/* Bottom Viewpoint Dock */
.hud-bottom
    display flex
    flex-direction column
    align-items center
    gap 10px
    width 100%
    max-width 560px
    margin 0 auto
    pointer-events auto

.viewpoints-dock
    background rgba(22, 13, 26, 0.88)
    backdrop-filter blur(14px)
    -webkit-backdrop-filter blur(14px)
    border 1px solid rgba(255, 255, 255, 0.18)
    border-radius 24px
    padding 5px 8px
    display flex
    align-items center
    gap 6px
    overflow-x auto
    scrollbar-width none

    &::-webkit-scrollbar
        display none

.viewpoint-btn
    background rgba(255, 255, 255, 0.08)
    border 1px solid rgba(255, 255, 255, 0.14)
    border-radius 16px
    padding 6px 12px
    color rgba(255, 255, 255, 0.85)
    font-size 11px
    font-weight 700
    display flex
    align-items center
    gap 5px
    cursor pointer
    white-space nowrap
    transition all 0.2s ease

    &:active
        transform scale(0.95)

    &.is-active
        background radial-gradient(circle, #38bdf8, #0369a1)
        border-color rgba(255, 255, 255, 0.5)
        color #ffffff
        box-shadow 0 0 14px rgba(56, 189, 248, 0.5)

.vr-instructions
    font-size 11px
    color rgba(255, 255, 255, 0.6)
    text-align center
    letter-spacing 0.3px
    text-shadow 0 2px 4px rgba(0, 0, 0, 0.8)

/* Fullscreen Gyroscope & Motion Permissions Modal (iOS Safari) */
.vr-start-modal
    position absolute
    top 50%
    left 50%
    transform translate(-50%, -50%)
    width @css{ min(380px, calc(100vw - 32px)) }
    background radial-gradient(ellipse at top, #2d1633 0%, #150c18 100%)
    backdrop-filter blur(20px)
    -webkit-backdrop-filter blur(20px)
    border 1px solid rgba(192, 132, 252, 0.4)
    border-radius 28px
    padding 28px 24px
    text-align center
    z-index 20
    box-shadow 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(168, 85, 247, 0.3)
    display flex
    flex-direction column
    align-items center
    gap 14px

    &.is-hidden
        display none

    .modal-goggles-icon
        font-size 48px
        filter drop-shadow(0 0 16px #a855f7)
        animation float 3s ease-in-out infinite

    h2
        font-family 'Pally-Bold', sans-serif
        font-size 22px
        color #ffffff

    p
        font-size 13px
        line-height 1.5
        color rgba(255, 255, 255, 0.8)

    .features-list
        list-style none
        display flex
        flex-direction column
        gap 6px
        width 100%
        text-align left
        margin 4px 0

        li
            font-size 11.5px
            color rgba(255, 255, 255, 0.75)
            display flex
            align-items center
            gap 8px

            span.check
                color #a855f7
                font-weight 900

    .enter-btn
        width 100%
        background radial-gradient(circle, #a855f7, #6b21a8)
        border 1px solid rgba(255, 255, 255, 0.4)
        color #ffffff
        font-family 'Pally-Bold', sans-serif
        font-size 15px
        padding 13px
        border-radius 20px
        cursor pointer
        box-shadow 0 8px 24px rgba(168, 85, 247, 0.5)
        transition all 0.2s ease

        &:active
            transform scale(0.96)

    .dismiss-btn
        background transparent
        border none
        color rgba(255, 255, 255, 0.6)
        font-size 12px
        cursor pointer
        text-decoration underline

@keyframes float
    0%, 100%
        transform translateY(0)
    50%
        transform translateY(-6px)

/* In-VR 3D Details Card (when gazing at a project or milestone) */
.vr-details-card
    position absolute
    bottom 90px
    left 50%
    transform translateX(-50%)
    width @css{ min(420px, calc(100vw - 32px)) }
    background rgba(22, 13, 26, 0.92)
    backdrop-filter blur(16px)
    -webkit-backdrop-filter blur(16px)
    border 1px solid rgba(192, 132, 252, 0.5)
    border-radius 20px
    padding 16px 20px
    z-index 10
    opacity 0
    pointer-events none
    transform translateX(-50%) translateY(12px)
    transition all 0.25s cubic-bezier(0.16, 1, 0.3, 1)

    &.is-visible
        opacity 1
        pointer-events auto
        transform translateX(-50%) translateY(0)

    .card-top
        display flex
        align-items center
        justify-content space-between
        margin-bottom 4px

    .card-category
        font-size 10px
        font-weight 800
        color #c084fc
        text-transform uppercase
        letter-spacing 0.5px

    .card-close
        background transparent
        border none
        color rgba(255, 255, 255, 0.6)
        font-size 16px
        cursor pointer

    .card-title
        font-family 'Pally-Bold', sans-serif
        font-size 16px
        color #ffffff
        margin-bottom 4px

    .card-desc
        font-size 12px
        color rgba(255, 255, 255, 0.8)
        line-height 1.45
        margin-bottom 8px

    .card-tags
        display flex
        flex-wrap wrap
        gap 5px

        span
            background rgba(255, 255, 255, 0.08)
            border 1px solid rgba(255, 255, 255, 0.12)
            padding 2px 7px
            border-radius 6px
            font-size 10px
            color rgba(255, 255, 255, 0.85)
