.start-screen
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    z-index 1000
    display flex
    align-items center
    justify-content center
    pointer-events auto
    transition opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s

    &.is-hidden
        opacity 0
        pointer-events none
        visibility hidden
        transform scale(1.03)

    .start-backdrop
        position absolute
        top 0
        left 0
        width 100%
        height 100%
        background radial-gradient(circle at center, rgba(12, 16, 28, 0.72) 0%, rgba(5, 7, 13, 0.92) 100%)
        backdrop-filter blur(8px)
        -webkit-backdrop-filter blur(8px)

    .start-card
        position relative
        z-index 2
        max-width 560px
        width calc(100% - 40px)
        padding 44px 36px
        border-radius 24px
        background rgba(15, 20, 35, 0.88)
        border 1px solid rgba(255, 255, 255, 0.14)
        box-shadow 0 30px 80px rgba(0, 0, 0, 0.65), 0 0 40px rgba(139, 92, 246, 0.15)
        text-align center
        font-family 'Nunito', -apple-system, BlinkMacSystemFont, sans-serif
        color #ffffff
        animation startCardFloat 3s ease-in-out infinite alternate

    .start-badge
        display inline-block
        padding 6px 16px
        border-radius 20px
        font-size 11px
        font-weight 800
        letter-spacing 1.5px
        text-transform uppercase
        color #c4b5fd
        background rgba(139, 92, 246, 0.16)
        border 1px solid rgba(139, 92, 246, 0.35)
        margin-bottom 18px

    .start-title
        margin 0 0 10px 0
        font-size 38px
        font-weight 900
        letter-spacing 1px
        color #ffffff
        text-shadow 0 2px 14px rgba(0, 0, 0, 0.5)

    .start-subtitle
        margin 0 0 28px 0
        font-size 15px
        font-weight 600
        line-height 1.5
        color #94a3b8

    .start-loading
        margin-top 10px

    .start-loading-bar-container
        width 100%
        height 8px
        border-radius 8px
        background rgba(255, 255, 255, 0.08)
        overflow hidden
        border 1px solid rgba(255, 255, 255, 0.1)
        margin-bottom 12px

    .start-loading-bar
        width 15%
        height 100%
        border-radius 8px
        background linear-gradient(90deg, #6366f1, #8b5cf6, #ec4899)
        transition width 0.25s ease-out

    .start-loading-text
        font-size 13px
        font-weight 600
        color #94a3b8
        letter-spacing 0.5px

    .start-btn
        display inline-flex
        align-items center
        justify-content center
        gap 12px
        padding 18px 42px
        border-radius 999px
        border none
        background linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%)
        color #ffffff
        font-family inherit
        font-size 16px
        font-weight 900
        letter-spacing 1px
        text-transform uppercase
        cursor pointer
        box-shadow 0 12px 30px rgba(168, 85, 247, 0.45), 0 0 20px rgba(99, 102, 241, 0.35)
        transition all 0.3s cubic-bezier(0.16, 1, 0.3, 1)
        position relative

        &:hover
            transform translateY(-2px) scale(1.03)
            box-shadow 0 16px 38px rgba(168, 85, 247, 0.6), 0 0 30px rgba(236, 72, 153, 0.4)

        &:active
            transform translateY(1px) scale(0.98)

        .start-btn-icon
            font-size 14px

    .start-hint
        margin-top 18px
        font-size 13px
        color #64748b

        kbd
            display inline-block
            padding 2px 7px
            margin 0 3px
            background rgba(255, 255, 255, 0.1)
            border 1px solid rgba(255, 255, 255, 0.2)
            border-radius 6px
            color #e2e8f0
            font-size 11px
            font-weight 700
            font-family inherit

@keyframes startCardFloat
    0%
        transform translateY(0px)
    100%
        transform translateY(-6px)
