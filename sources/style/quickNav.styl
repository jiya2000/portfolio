.quick-nav
    display none
    position fixed
    top 16px
    left 50%
    transform translateX(-50%)
    z-index 10
    background rgba(18, 16, 28, 0.78)
    backdrop-filter blur(14px)
    -webkit-backdrop-filter blur(14px)
    border 1px solid rgba(255, 255, 255, 0.15)
    border-radius 40px
    padding 5px 8px
    box-shadow 0 8px 30px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1)
    gap 6px
    align-items center
    transition transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease
    user-select none
    -webkit-user-select none

    html.is-started &
        display flex

    html.input-filter-menu &,
    html.input-filter-modal &,
    html.input-filter-intro &,
    html.input-filter-cinematic &
        opacity 0
        pointer-events none
        transform translateX(-50%) translateY(-20px)

    .nav-btn
        display inline-flex
        align-items center
        gap 6px
        padding 7px 13px
        border none
        background transparent
        color #f0f2f8
        font-family 'Nunito', sans-serif
        font-weight 700
        font-size 13px
        letter-spacing 0.3px
        border-radius 30px
        cursor pointer
        transition all 0.2s cubic-bezier(0.16, 1, 0.3, 1)
        position relative
        outline none

        .icon
            font-size 15px
            line-height 1
            display inline-block
            transition transform 0.2s ease

        .label
            white-space nowrap

        &:hover
            background rgba(255, 255, 255, 0.12)
            color #ffffff
            transform translateY(-1px)

            .icon
                transform scale(1.18)

        &:active
            transform translateY(1px)
            background rgba(255, 255, 255, 0.08)

        &.is-active
            background linear-gradient(135deg, rgba(235, 75, 75, 0.85), rgba(168, 48, 148, 0.85))
            color #ffffff
            box-shadow 0 2px 10px rgba(235, 75, 75, 0.35)

        &.is-map
            background rgba(255, 255, 255, 0.08)
            border 1px solid rgba(255, 255, 255, 0.12)

            &:hover
                background rgba(255, 255, 255, 0.18)

@media (max-width: 768px)
    .quick-nav
        top 12px
        padding 4px 6px
        gap 3px
        max-width calc(100vw - 120px)
        overflow-x auto
        scrollbar-width none

        &::-webkit-scrollbar
            display none

        .nav-btn
            padding 6px 9px
            font-size 12px
            gap 4px

            .label
                display none

            &.is-map .label,
            &:first-child .label
                display inline
