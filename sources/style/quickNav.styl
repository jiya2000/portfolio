.quick-nav
    display none
    position fixed
    top 20px
    left 50%
    transform translateX(-50%)
    z-index 10
    background radial-gradient(ellipse at top, rgba(45, 24, 40, 0.94) 0%, rgba(24, 18, 28, 0.94) 100%)
    backdrop-filter blur(16px)
    -webkit-backdrop-filter blur(16px)
    border 1px solid rgba(255, 255, 255, 0.22)
    border-radius 24px
    padding 4px 6px
    box-shadow 0 10px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.2)
    gap 4px
    align-items center
    transition transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease
    user-select none
    -webkit-user-select none

    html.is-started &
        display flex

    html.input-filter-menu &,
    html.input-filter-modal &,
    html.input-filter-intro &,
    html.input-filter-cinematic &
        opacity 0
        pointer-events none
        transform translateX(-50%) translateY(-20px)

    .nav-btn
        display inline-flex
        align-items center
        gap 7px
        padding 7px 14px
        border none
        background transparent
        color rgba(255, 255, 255, 0.75)
        font-family 'Pally-Bold', 'Nunito', sans-serif
        font-weight 700
        font-size 12px
        letter-spacing 0.6px
        text-transform uppercase
        border-radius 18px
        cursor pointer
        transition all 0.2s cubic-bezier(0.16, 1, 0.3, 1)
        position relative
        outline none

        .icon
            display inline-flex
            align-items center
            justify-content center
            width 14px
            height 14px
            line-height 1
            color inherit
            transition transform 0.2s ease

            svg
                display block
                width 100%
                height 100%

            img
                display block
                filter brightness(0) invert(1)
                opacity 0.75

        .label
            white-space nowrap

        &:hover
            background rgba(255, 255, 255, 0.1)
            color #ffffff
            transform translateY(-1px)

            .icon
                transform scale(1.1)

                img
                    opacity 1

        &:active
            transform translateY(1px)
            background rgba(255, 255, 255, 0.06)

        &.is-active
            background radial-gradient(ellipse at top right, #C21515, #5e1337)
            color #ffffff
            box-shadow 0 3px 12px rgba(194, 21, 21, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.3)

            .icon img
                opacity 1

        &.is-vr
            background radial-gradient(circle, rgba(168, 85, 247, 0.35) 0%, rgba(88, 28, 135, 0.5) 100%)
            border 1px solid rgba(192, 132, 252, 0.6)
            color #ffffff
            box-shadow 0 0 12px rgba(168, 85, 247, 0.4)

            &:hover
                background radial-gradient(circle, rgba(168, 85, 247, 0.6) 0%, rgba(88, 28, 135, 0.8) 100%)
                border-color rgba(255, 255, 255, 0.7)
                box-shadow 0 0 18px rgba(168, 85, 247, 0.7)

        &.is-ar,
        &.is-map
            background rgba(255, 255, 255, 0.08)
            border 1px solid rgba(255, 255, 255, 0.15)
            color #ffffff

            &:hover
                background rgba(255, 255, 255, 0.18)

    .nav-divider
        width 1px
        height 18px
        background rgba(255, 255, 255, 0.15)
        margin 0 2px

@media (max-width: 768px)
    .quick-nav
        top 12px
        padding 4px
        gap 2px
        max-width calc(100vw - 110px)
        overflow-x auto
        scrollbar-width none

        &::-webkit-scrollbar
            display none

        .nav-btn
            padding 6px 9px
            font-size 11px
            gap 4px

            .label
                display none

            &.is-ar .label,
            &.is-map .label,
            &:first-child .label
                display inline
